{
  "name": "neuro-canvas-lms",
  "version": "2.14.0",
  "description": "Canvas LMS MCP server for Claude and ChatGPT: read-only, deployed to your own free Cloudflare account with one command",
  "keywords": [
    "canvas",
    "canvas-lms",
    "canvas-mcp",
    "instructure",
    "lms",
    "mcp",
    "mcp-server",
    "remote-mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "chatgpt",
    "cloudflare-workers",
    "students",
    "education"
  ],
  "homepage": "https://github.com/BloodyReginaa/Neuro-CanvasLMS#readme",
  "bugs": {
    "url": "https://github.com/BloodyReginaa/Neuro-CanvasLMS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BloodyReginaa/Neuro-CanvasLMS.git"
  },
  "license": "MIT",
  "author": "BloodyReginaa",
  "scripts": {
    "test": "node --import ./test-setup.mjs --test",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "format": "prettier --write \"*.mjs\" \"bin/*.mjs\" \"scripts/*.mjs\" \"installer/*.mjs\"",
    "format:check": "prettier --check \"*.mjs\" \"bin/*.mjs\" \"scripts/*.mjs\" \"installer/*.mjs\"",
    "setup": "node bin/neuro-canvas-lms.mjs",
    "prepublishOnly": "npm test && npm run format:check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "ipaddr.js": "2.2.0",
    "unpdf": "^1.8.1",
    "wrangler": "^4.136.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "neuro-canvas-lms": "bin/neuro-canvas-lms.mjs"
  }
}
