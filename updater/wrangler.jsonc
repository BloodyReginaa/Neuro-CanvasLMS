{
  // The updater Worker. The setup skill fills in the REPLACE_ values.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "neuro-canvas-lms-updater",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  // No public URL: reachable only by its cron trigger and the connector's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // Same KV namespace as the connector's OAUTH_KV (status/mode are shared through it).
  "kv_namespaces": [{ "binding": "STATE", "id": "REPLACE_WITH_THE_CONNECTOR_KV_ID" }],
  // The connector this updater looks after.
  "services": [{ "binding": "MAIN", "service": "neuro-canvas-lms" }],
  "vars": {
    "ACCOUNT_ID": "REPLACE_WITH_YOUR_CLOUDFLARE_ACCOUNT_ID",
    "TARGET_SCRIPT": "neuro-canvas-lms",
    // Chosen during setup: "auto" (install after a 24 h observation period, health-checked,
    // rolled back on failure) or "notify" (only tell you; install when you ask your AI).
    "UPDATE_MODE": "auto",
    // "stable" waits 24 h after each release; "early" installs at once (the maintainer's canary).
    "CHANNEL": "stable",
  },
  // Secret (set with `npx wrangler secret put CF_API_TOKEN -c updater/wrangler.jsonc`):
  //   CF_API_TOKEN — a Cloudflare API token with ONLY "Account · Workers Scripts · Edit".
}
