{
  // Manual deployment template. Most people should just run the installer instead:
  //   npx -y neuro-canvas-lms        (or: npm run setup)
  // which fills all of this in for you.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Becomes https://<name>.<your-subdomain>.workers.dev — change it if you like.
  "name": "neuro-canvas-lms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Persistent Workers Logs (free tier, a few days of retention) for the lines this Worker writes
  // itself: path/method/status, MCP method names, transport path. Automatic invocation logs are
  // OFF so request headers (which carry OAuth access tokens) are never stored.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create neuro-canvas-lms-oauth — then paste the id here.
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" },
  ],
  "vars": {
    // Your school's Canvas host, e.g. "canvas.example.edu" (what you see in the address bar).
    "CANVAS_HOST": "REPLACE_WITH_YOUR_CANVAS_HOST",
    // Optional: shown on the connector's pages.
    "SCHOOL_NAME": "",
    // Optional:
    //   "ACCENT_COLOR": "#4f5bd5",  page colour
    //   "OWNER_CANVAS_ID": "123456", pin the owner instead of "first account to authorize wins"
    //   "CANVAS_TRANSPORT": "auto",  "auto" (fetch, retry over TLS socket if rejected), "fetch" or "socket"
  },
}
