{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Becomes https://<name>.<your-subdomain>.workers.dev — change it if you like.
  "name": "neuro-canvas-lms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Persistent Workers Logs (free tier, a few days of retention) for the lines this Worker writes
  // itself: path/method/status, MCP method names, transport path. Automatic invocation logs are
  // OFF so request headers (which carry OAuth access tokens) are never stored.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create neuro-canvas-lms-oauth   — then paste the id here.
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  // Automatic updates / reminders (setup Step 6): after deploying updater/wrangler.jsonc,
  // uncomment this so the connector's `connector_update` tool can reach the updater.
  // "services": [{ "binding": "UPDATER", "service": "neuro-canvas-lms-updater" }],
  // Optional vars:
  //   OWNER_CANVAS_ID  — pin the owner instead of "first account to authorize wins".
  //   CANVAS_TRANSPORT — "auto" (default: fetch, retry over TLS socket if rejected), "fetch" or "socket".
  // ,"vars": { "OWNER_CANVAS_ID": "123456" }
}
