{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Becomes https://<name>.<your-subdomain>.workers.dev — change it if you like.
  "name": "neuro-canvas-lms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": false },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create OAUTH_KV   — then paste the id here.
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ]
  // Optional: pin the owner instead of "first account to authorize wins".
  // ,"vars": { "OWNER_CANVAS_ID": "123456" }
}
